# ==============================================================================
# RizLife QuestCard Management System — Environment Configuration
# Copy this file to .env at the repository root for local development,
# and configure the corresponding variables in each Vercel Project's settings.
# ==============================================================================

# 1. PostgreSQL Connection String (Supabase / Neon / Local Docker Postgres)
# For Supabase Pooler on Vercel, append ?pgbouncer=true&connection_limit=1
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SECRET_KEY=""
SUPABASE_JWKS_URL=""

# 2. Session Signing Secret (generate a random 32+ char string for production)
# Must be identical if you want consistent tokens, though each portal has its own cookie name.
JWT_SECRET="replace-with-a-secure-random-32-char-secret-key"

# 3. Portal URLs (used in digest emails & navigation links)
NEXT_PUBLIC_STUDENT_PORTAL_URL="http://localhost:3001"
NEXT_PUBLIC_TEACHER_PORTAL_URL="http://localhost:3002"
NEXT_PUBLIC_ADMIN_PORTAL_URL="http://localhost:3003"

# 4. Email Delivery (Batched Outlook Digest)
# Mode is controlled in Admin Global Settings ("preview" | "resend" | "smtp"),
# or falls back automatically based on configured credentials.
RESEND_API_KEY=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"
EMAIL_FROM="RizLife QuestCard <noreply@rizlife.apc.edu.ph>"

# 5. Vercel Cron Protection (used by /api/cron/digest on apps/teacher)
CRON_SECRET="replace-with-cron-secret"

# 6. APC Microsoft Entra ID / Azure AD SSO (Phase 2 — leave blank until IT provides credentials)
# Redirect URIs to register in Azure Portal:
#   - https://<student-domain>/api/auth/microsoft/callback
#   - https://<teacher-domain>/api/auth/microsoft/callback
#   - https://<admin-domain>/api/auth/microsoft/callback
AZURE_AD_CLIENT_ID=""
AZURE_AD_CLIENT_SECRET=""
AZURE_AD_TENANT_ID=""
